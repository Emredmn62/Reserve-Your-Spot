<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Reserve_Your_Spot.Controls.BusinessCard">
    <Border BackgroundColor="{StaticResource ColorSurface}"
            Stroke="{StaticResource ColorSurface2}"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Margin="0,0,0,12">
        <Border.Shadow>
            <Shadow Brush="Black" Offset="0,4" Radius="12" Opacity="0.4" />
        </Border.Shadow>
        <Grid RowDefinitions="130,Auto">

            <!-- Cover image -->
            <Grid Grid.Row="0">
                <Image x:Name="CoverImg"
                       Aspect="AspectFill"
                       HeightRequest="130"
                       BackgroundColor="{StaticResource ColorSurface2}" />
                <!-- Featured badge -->
                <Border x:Name="FeaturedBadge"
                        BackgroundColor="{StaticResource ColorGold}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 6"
                        Padding="8,4"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,8,8,0"
                        IsVisible="False">
                    <Label Text="FEATURED" TextColor="{StaticResource ColorBlack}"
                           FontSize="10" FontAttributes="Bold" />
                </Border>
            </Grid>

            <!-- Info -->
            <VerticalStackLayout Grid.Row="1" Padding="12,10">
                <Label x:Name="NameLabel"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource ColorWhite}"
                       LineBreakMode="TailTruncation" />
                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                    <Label x:Name="RatingLabel" FontSize="12" TextColor="{StaticResource ColorGold}" />
                    <Label x:Name="ReviewsLabel" FontSize="12" TextColor="{StaticResource ColorGrey}" />
                    <Label Text="·" TextColor="{StaticResource ColorGrey}" FontSize="12" />
                    <Label x:Name="DistanceLabel" FontSize="12" TextColor="{StaticResource ColorGrey}" />
                </HorizontalStackLayout>
                <Label x:Name="CategoryLabel"
                       FontSize="12" TextColor="{StaticResource ColorGold}"
                       Margin="0,4,0,0" />
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
