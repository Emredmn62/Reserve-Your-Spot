<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Reserve_Your_Spot.Controls.BookingCard">
    <Border BackgroundColor="{StaticResource ColorSurface}"
            Stroke="{StaticResource ColorSurface2}"
            StrokeShape="RoundRectangle 12"
            Padding="14"
            Margin="0,0,0,10">
        <Grid ColumnDefinitions="70,*,Auto" RowDefinitions="Auto,Auto">
            <!-- Date/time column -->
            <VerticalStackLayout Grid.Column="0" Grid.RowSpan="2"
                                 VerticalOptions="Center" Spacing="2">
                <Label x:Name="TimeLabel"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource ColorGold}" />
                <Label x:Name="DateLabel"
                       FontSize="11" TextColor="{StaticResource ColorGrey}"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <!-- Business + service -->
            <Label Grid.Column="1" Grid.Row="0"
                   x:Name="BusinessLabel"
                   FontSize="15" FontAttributes="Bold"
                   TextColor="{StaticResource ColorWhite}"
                   Margin="12,0,0,0" />
            <Label Grid.Column="1" Grid.Row="1"
                   x:Name="ServiceLabel"
                   FontSize="12" TextColor="{StaticResource ColorGrey}"
                   Margin="12,0,0,0" />

            <!-- Status badge -->
            <Border Grid.Column="2" Grid.Row="0"
                    x:Name="StatusBadge"
                    StrokeShape="RoundRectangle 8"
                    Stroke="Transparent"
                    Padding="8,4"
                    VerticalOptions="Center">
                <Label x:Name="StatusLabel"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource ColorBlack}" />
            </Border>

            <!-- Staff + price -->
            <Label Grid.Column="2" Grid.Row="1"
                   x:Name="PriceLabel"
                   FontSize="12" TextColor="{StaticResource ColorGrey}"
                   HorizontalOptions="End" />
        </Grid>
    </Border>
</ContentView>
