<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Reserve_Your_Spot.ViewModels.BusinessPortal"
             xmlns:models="clr-namespace:Reserve_Your_Spot.Models"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             x:Class="Reserve_Your_Spot.Views.BusinessPortal.BlockTimePage"
             Title="Block Time"
             BackgroundColor="{StaticResource ColorBlack}">

    <ScrollView>
        <VerticalStackLayout Padding="24,20,24,32" Spacing="16">

            <Label Text="Block time off"
                   FontSize="22" FontAttributes="Bold"
                   TextColor="{StaticResource ColorWhite}" />
            <Label Text="Blocked times just show as unavailable to customers — no reason is shown."
                   FontSize="13" TextColor="{StaticResource ColorGrey}" />

            <!-- Date -->
            <Label Text="Date" TextColor="{StaticResource ColorGrey}" FontSize="13" Margin="0,8,0,0" />
            <Border BackgroundColor="{StaticResource ColorSurface}" Stroke="{StaticResource ColorSurface2}"
                    StrokeShape="RoundRectangle 12" Padding="14,0">
                <DatePicker Date="{Binding SelectedDate}" MinimumDate="{x:Static sys:DateTime.Today}"
                            TextColor="{StaticResource ColorWhite}" BackgroundColor="Transparent" />
            </Border>

            <!-- Start / End -->
            <Grid ColumnDefinitions="*,12,*">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Label Text="From" TextColor="{StaticResource ColorGrey}" FontSize="13" />
                    <Border BackgroundColor="{StaticResource ColorSurface}" Stroke="{StaticResource ColorSurface2}"
                            StrokeShape="RoundRectangle 12" Padding="14,0">
                        <TimePicker Time="{Binding StartTime}" TextColor="{StaticResource ColorWhite}"
                                    BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <Label Text="To" TextColor="{StaticResource ColorGrey}" FontSize="13" />
                    <Border BackgroundColor="{StaticResource ColorSurface}" Stroke="{StaticResource ColorSurface2}"
                            StrokeShape="RoundRectangle 12" Padding="14,0">
                        <TimePicker Time="{Binding EndTime}" TextColor="{StaticResource ColorWhite}"
                                    BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <!-- Who -->
            <Label Text="Who is this for?" TextColor="{StaticResource ColorGrey}" FontSize="13" />
            <Border BackgroundColor="{StaticResource ColorSurface}" Stroke="{StaticResource ColorSurface2}"
                    StrokeShape="RoundRectangle 12" Padding="14,0">
                <Picker ItemsSource="{Binding StaffOptions}"
                        SelectedItem="{Binding SelectedStaffOption}"
                        TextColor="{StaticResource ColorWhite}"
                        TitleColor="{StaticResource ColorGrey}"
                        BackgroundColor="Transparent">
                    <Picker.ItemDisplayBinding>
                        <Binding Path="Label" />
                    </Picker.ItemDisplayBinding>
                </Picker>
            </Border>

            <!-- Note -->
            <Label Text="Note (optional, for you only)" TextColor="{StaticResource ColorGrey}" FontSize="13" />
            <Border BackgroundColor="{StaticResource ColorSurface}" Stroke="{StaticResource ColorSurface2}"
                    StrokeShape="RoundRectangle 12" Padding="12">
                <Entry Text="{Binding Note}" Placeholder="e.g. Dentist appointment"
                       BackgroundColor="Transparent" TextColor="{StaticResource ColorWhite}"
                       PlaceholderColor="{StaticResource ColorGrey}" />
            </Border>

            <!-- Error -->
            <Border BackgroundColor="#3D1515" Stroke="{StaticResource ColorError}"
                    StrokeShape="RoundRectangle 8" Padding="12"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorError}" FontSize="14" />
            </Border>

            <Button Text="Block this time"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                    BackgroundColor="{StaticResource ColorGold}"
                    TextColor="{StaticResource ColorBlack}"
                    CornerRadius="12" HeightRequest="50"
                    FontAttributes="Bold" FontSize="15" Margin="0,4,0,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{StaticResource ColorGold}" />

            <!-- Upcoming blocks -->
            <Label Text="Upcoming blocked times" FontSize="17" FontAttributes="Bold"
                   TextColor="{StaticResource ColorWhite}" Margin="0,16,0,0" />

            <CollectionView ItemsSource="{Binding Blocks}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BlockedTime">
                        <Border BackgroundColor="{StaticResource ColorSurface}"
                                Stroke="{StaticResource ColorSurface2}"
                                StrokeShape="RoundRectangle 12"
                                Padding="14" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label Text="{Binding DateDisplay}" FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorWhite}" />
                                    <Label Text="{Binding TimeDisplay}" FontSize="13"
                                           TextColor="{StaticResource ColorGold}" />
                                    <Label Text="{Binding Note}" FontSize="12"
                                           TextColor="{StaticResource ColorGrey}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="Remove"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BlockTimeViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource ColorError}"
                                        BorderColor="{StaticResource ColorError}"
                                        BorderWidth="1"
                                        CornerRadius="8" HeightRequest="36"
                                        FontSize="12" Padding="12,0"
                                        VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="No blocked times right now." FontSize="14"
                           TextColor="{StaticResource ColorGrey}" Margin="0,8,0,0" />
                </CollectionView.EmptyView>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
