<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Reserve_Your_Spot.Models"
             xmlns:controls="clr-namespace:Reserve_Your_Spot.Controls"
             x:Class="Reserve_Your_Spot.Views.BusinessPortal.CalendarPage"
             Title="Calendar"
             BackgroundColor="{StaticResource ColorBlack}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Header / nav -->
        <Grid Grid.Row="0" ColumnDefinitions="40,*,40"
              Padding="16,52,16,12"
              BackgroundColor="{StaticResource ColorBlack}">
            <Border Grid.Column="0" BackgroundColor="{StaticResource ColorSurface}"
                    StrokeShape="Ellipse" Stroke="Transparent"
                    HeightRequest="36" WidthRequest="36">
                <Label Text="‹" FontSize="20" TextColor="{StaticResource ColorWhite}"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            <Label Grid.Column="1" Text="{Binding PeriodLabel}"
                   FontSize="17" FontAttributes="Bold"
                   TextColor="{StaticResource ColorWhite}"
                   HorizontalOptions="Center" VerticalOptions="Center" />
            <Border Grid.Column="2" BackgroundColor="{StaticResource ColorSurface}"
                    StrokeShape="Ellipse" Stroke="Transparent"
                    HeightRequest="36" WidthRequest="36">
                <Label Text="›" FontSize="20" TextColor="{StaticResource ColorWhite}"
                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NextCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
        </Grid>

        <!-- Week/Month toggle -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="16,0,16,12">
            <Border Padding="14,8" StrokeShape="RoundRectangle 8">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsWeekView}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource ColorGold}" />
                        <Setter Property="Stroke" Value="{StaticResource ColorGold}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="Week" FontSize="13" TextColor="{StaticResource ColorWhite}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleViewCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleViewCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border Padding="14,8" StrokeShape="RoundRectangle 8">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsWeekView}" Value="False">
                        <Setter Property="BackgroundColor" Value="{StaticResource ColorGold}" />
                        <Setter Property="Stroke" Value="{StaticResource ColorGold}" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="Month" FontSize="13" TextColor="{StaticResource ColorWhite}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleViewCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleViewCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </HorizontalStackLayout>

        <!-- Booking list for period -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding DisplayedBookings}"
                        Margin="16,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <!-- Calendar block style -->
                    <Border BackgroundColor="{StaticResource ColorGold}"
                            StrokeShape="RoundRectangle 8"
                            Stroke="Transparent"
                            Padding="12,8"
                            Margin="0,0,0,8">
                        <Grid ColumnDefinitions="70,*">
                            <Label Grid.Column="0"
                                   Text="{Binding TimeDisplay}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorBlack}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{Binding Service.Name}"
                                       FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorBlack}"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding Customer.FullName}"
                                       FontSize="12" TextColor="#80000000" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8" Margin="0,80,0,0">
                    <Label Text="📆" FontSize="48" HorizontalOptions="Center" />
                    <Label Text="No bookings in this period"
                           FontSize="15" TextColor="{StaticResource ColorGrey}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

    </Grid>
</ContentPage>
