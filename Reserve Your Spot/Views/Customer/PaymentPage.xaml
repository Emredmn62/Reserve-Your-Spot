<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Reserve_Your_Spot.Converters"
             x:Class="Reserve_Your_Spot.Views.Customer.PaymentPage"
             Title="Confirm &amp; Pay"
             BackgroundColor="{StaticResource ColorBlack}">

    <ContentPage.Resources>
        <converters:PriceFormatter x:Key="PriceFmt" />
        <converters:DateFormatter x:Key="DateFmt" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" Padding="24,16,24,0">
            <VerticalStackLayout Spacing="20">

                <Label Text="Confirm &amp; Pay"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource ColorWhite}" />

                <!-- Order summary card -->
                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource ColorSurface2}"
                        StrokeShape="RoundRectangle 16"
                        Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Business.Name}"
                               FontSize="17" FontAttributes="Bold"
                               TextColor="{StaticResource ColorWhite}" />
                        <Label Text="{Binding Service.Name}"
                               FontSize="14" TextColor="{StaticResource ColorGrey}" />
                        <Label Text="{Binding SelectedDateTime, Converter={StaticResource DateFmt}, ConverterParameter=long}"
                               FontSize="14" TextColor="{StaticResource ColorGrey}" />
                        <Label Text="{Binding SelectedStaff.Name, StringFormat='with {0}', FallbackValue='Any Available'}"
                               FontSize="14" TextColor="{StaticResource ColorGrey}" />

                        <BoxView Color="{StaticResource ColorSurface2}" HeightRequest="1" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Total to pay" FontSize="17" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorWhite}" />
                            <Label Grid.Column="1" Text="{Binding TotalPrice, Converter={StaticResource PriceFmt}}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorGold}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- How payment works -->
                <Border BackgroundColor="{StaticResource ColorSurface}"
                        Stroke="{StaticResource ColorSurface2}"
                        StrokeShape="RoundRectangle 14"
                        Padding="16">
                    <HorizontalStackLayout Spacing="12">
                        <Label Text="🔒" FontSize="20" VerticalOptions="Center" />
                        <Label FontSize="13" TextColor="{StaticResource ColorGrey}"
                               LineBreakMode="WordWrap" VerticalOptions="Center"
                               HorizontalOptions="Fill">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Paid securely with Stripe. " TextColor="{StaticResource ColorWhite}" FontAttributes="Bold" />
                                    <Span Text="You'll be taken to a secure payment page — come back here once it's done." />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </HorizontalStackLayout>
                </Border>

                <!-- Waiting for payment to confirm -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding IsWaitingForPayment}"
                                     HorizontalOptions="Center" Margin="0,10">
                    <ActivityIndicator IsRunning="{Binding IsWaitingForPayment}" Color="{StaticResource ColorGold}" />
                    <Label Text="{Binding WaitingMessage}" FontSize="13" TextColor="{StaticResource ColorGrey}"
                           HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Error -->
                <Border BackgroundColor="#3D1515"
                        Stroke="{StaticResource ColorError}"
                        StrokeShape="RoundRectangle 8"
                        Padding="12"
                        IsVisible="{Binding HasError}">
                    <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ColorError}" FontSize="14" />
                </Border>

                <!-- Cancellation note -->
                <Label Text="By paying you agree to the cancellation policy. Refunds depend on how close to your appointment you cancel."
                       FontSize="11" TextColor="{StaticResource ColorGrey}"
                       LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="{StaticResource ColorBlack}"
                Stroke="{StaticResource ColorSurface2}" StrokeShape="RoundRectangle 0"
                Padding="24,12">
            <VerticalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource ColorGold}" />
                <Button Command="{Binding PayNowCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                        BackgroundColor="{StaticResource ColorGold}"
                        TextColor="{StaticResource ColorBlack}"
                        CornerRadius="12" HeightRequest="52"
                        FontAttributes="Bold" FontSize="16">
                    <Button.Text>
                        <MultiBinding StringFormat="Pay &amp; Book — £{0:F2}">
                            <Binding Path="TotalPrice" />
                        </MultiBinding>
                    </Button.Text>
                </Button>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
