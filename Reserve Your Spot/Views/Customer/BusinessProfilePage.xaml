<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Reserve_Your_Spot.ViewModels"
             xmlns:models="clr-namespace:Reserve_Your_Spot.Models"
             xmlns:controls="clr-namespace:Reserve_Your_Spot.Controls"
             x:Class="Reserve_Your_Spot.Views.Customer.BusinessProfilePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource ColorBlack}">

    <Grid RowDefinitions="*,80">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout>

                <!-- Cover + back button overlay -->
                <Grid HeightRequest="240">
                    <Image x:Name="CoverImage"
                           Aspect="AspectFill"
                           HeightRequest="240"
                           BackgroundColor="{StaticResource ColorSurface}" />
                    <!-- Dark gradient overlay -->
                    <BoxView BackgroundColor="#AA000000" />
                    <!-- Back button -->
                    <Border BackgroundColor="#88000000"
                            StrokeShape="Ellipse"
                            Stroke="Transparent"
                            HeightRequest="40" WidthRequest="40"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            Margin="16,52,0,0">
                        <Label Text="←" FontSize="20" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Border>
                    <!-- Logo overlapping bottom -->
                    <Border BackgroundColor="{StaticResource ColorSurface}"
                            StrokeShape="Ellipse"
                            Stroke="{StaticResource ColorGold}"
                            StrokeThickness="3"
                            HeightRequest="72" WidthRequest="72"
                            HorizontalOptions="Start"
                            VerticalOptions="End"
                            Margin="24,0,0,20">
                        <Label x:Name="LogoInitials"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource ColorGold}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Business info -->
                <VerticalStackLayout Padding="24,8,24,0" Spacing="8">
                    <Label x:Name="BusinessNameLabel"
                           FontSize="24" FontAttributes="Bold"
                           TextColor="{StaticResource ColorWhite}" />
                    <HorizontalStackLayout Spacing="10">
                        <Border BackgroundColor="#33C9A84C"
                                Stroke="{StaticResource ColorGold}"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,4">
                            <Label x:Name="CategoryLabel" FontSize="12" TextColor="{StaticResource ColorGold}" />
                        </Border>
                        <Label x:Name="RatingLabel" FontSize="13" TextColor="{StaticResource ColorGold}" />
                        <Label x:Name="ReviewCountLabel" FontSize="13" TextColor="{StaticResource ColorGrey}" />
                    </HorizontalStackLayout>
                    <Label x:Name="AddressLabel" FontSize="13" TextColor="{StaticResource ColorGrey}" />

                    <!-- Action row -->
                    <HorizontalStackLayout Spacing="12" Margin="0,8,0,8">
                        <Border BackgroundColor="{StaticResource ColorSurface2}"
                                StrokeShape="Ellipse" Stroke="Transparent"
                                HeightRequest="44" WidthRequest="44">
                            <Label Text="📞" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CallCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border BackgroundColor="{StaticResource ColorSurface2}"
                                StrokeShape="Ellipse" Stroke="Transparent"
                                HeightRequest="44" WidthRequest="44">
                            <Label Text="💬" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding WhatsAppCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border x:Name="FavBtn"
                                BackgroundColor="{StaticResource ColorSurface2}"
                                StrokeShape="Ellipse" Stroke="Transparent"
                                HeightRequest="44" WidthRequest="44">
                            <Label x:Name="FavIcon" Text="🤍" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleFavouriteCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                        <Border BackgroundColor="{StaticResource ColorSurface2}"
                                StrokeShape="Ellipse" Stroke="Transparent"
                                HeightRequest="44" WidthRequest="44">
                            <Label Text="↑" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ShareCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Tab bar -->
                    <HorizontalStackLayout Spacing="0" Margin="0,8,0,0">
                        <Label x:Name="TabServices" Text="Services"
                               FontSize="14" Padding="0,8,16,8"
                               TextColor="{StaticResource ColorGold}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Services" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="TabStaff" Text="Staff"
                               FontSize="14" Padding="0,8,16,8"
                               TextColor="{StaticResource ColorGrey}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Staff" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="TabReviews" Text="Reviews"
                               FontSize="14" Padding="0,8,16,8"
                               TextColor="{StaticResource ColorGrey}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Reviews" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label x:Name="TabInfo" Text="Info"
                               FontSize="14" Padding="0,8,0,8"
                               TextColor="{StaticResource ColorGrey}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectTabCommand}" CommandParameter="Info" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <!-- Gold underline -->
                    <BoxView x:Name="TabUnderline" Color="{StaticResource ColorGold}"
                             HeightRequest="2" WidthRequest="60"
                             HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Tab content -->
                <!-- Services -->
                <VerticalStackLayout x:Name="ServicesPanel" Padding="24,12,24,0">
                    <CollectionView ItemsSource="{Binding Services}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Service">
                                <controls:ServiceCard Service="{Binding .}" ServiceTapped="OnServiceTapped" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No services listed yet." TextColor="{StaticResource ColorGrey}"
                                   FontSize="14" Margin="0,16" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Staff -->
                <CollectionView x:Name="StaffPanel"
                                ItemsSource="{Binding Staff}"
                                HeightRequest="160"
                                IsVisible="False"
                                Margin="0,12,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="16" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header><BoxView WidthRequest="24" Color="Transparent"/></CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Staff">
                            <VerticalStackLayout Spacing="8" WidthRequest="90">
                                <Border BackgroundColor="{StaticResource ColorSurface2}"
                                        StrokeShape="Ellipse" Stroke="{StaticResource ColorGold}"
                                        HeightRequest="64" WidthRequest="64"
                                        HorizontalOptions="Center">
                                    <Label Text="👤" FontSize="28"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding Name}" FontSize="13" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorWhite}"
                                       HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="{Binding Role}" FontSize="11"
                                       TextColor="{StaticResource ColorGrey}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Reviews -->
                <VerticalStackLayout x:Name="ReviewsPanel" Padding="24,12,24,0" IsVisible="False" Spacing="12">
                    <CollectionView ItemsSource="{Binding Reviews}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Review">
                                <Border BackgroundColor="{StaticResource ColorSurface}"
                                        Stroke="{StaticResource ColorSurface2}"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="14"
                                        Margin="0,0,0,10">
                                    <VerticalStackLayout Spacing="6">
                                        <HorizontalStackLayout Spacing="8">
                                            <controls:StarRating Rating="{Binding Rating}" StarSize="14" />
                                            <Label Text="{Binding DateDisplay}" FontSize="11"
                                                   TextColor="{StaticResource ColorGrey}"
                                                   VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding Comment}" FontSize="13"
                                               TextColor="{StaticResource ColorWhite}" />
                                        <Label Text="{Binding CustomerName}" FontSize="12"
                                               TextColor="{StaticResource ColorGrey}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No reviews yet." TextColor="{StaticResource ColorGrey}" FontSize="14" />
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Info -->
                <VerticalStackLayout x:Name="InfoPanel" Padding="24,12,24,16" IsVisible="False" Spacing="12">
                    <Label x:Name="DescriptionLabel" FontSize="14" TextColor="{StaticResource ColorGrey}"
                           LineBreakMode="WordWrap" />
                    <Label x:Name="InfoAddressLabel" FontSize="14" TextColor="{StaticResource ColorWhite}" />
                    <Label x:Name="CancellationLabel" FontSize="13" TextColor="{StaticResource ColorGrey}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Sticky Book Now button -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource ColorBlack}"
                Stroke="{StaticResource ColorSurface2}"
                StrokeShape="RoundRectangle 0"
                Padding="24,12">
            <Button Text="Book Now"
                    Command="{Binding BookNowCommand}"
                    BackgroundColor="{StaticResource ColorGold}"
                    TextColor="{StaticResource ColorBlack}"
                    CornerRadius="12"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    FontSize="17" />
        </Border>

    </Grid>
</ContentPage>
